# ==============================================================================
# PUSHPAK Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=pushpak-api
APP_VERSION=0.1.0

# Server Binding
HOST=0.0.0.0
PORT=8000

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
# Requirement: PostgreSQL 18+ service running locally.
# Step 1: Open psql or pgAdmin and create the database if not already created:
#         CREATE DATABASE pushpak_db;
# Step 2: Fill in your actual PostgreSQL credentials below:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pushpak_db

# Optional direct database connection string (overrides the parts above if set).
# Uses psycopg 3 dialect: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/pushpak_db

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
